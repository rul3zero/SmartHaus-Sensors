# =============================================================================
# PlatformIO Project .gitignore
# =============================================================================

# ---------------------------
# PlatformIO Build & Cache
# ---------------------------
.pio/
.pioenvs/
.piolibdeps/

# ---------------------------
# VS Code / IDE
# ---------------------------
# IntelliSense database (regenerated automatically)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/ipch/

# Local launch/debug config (optional - keep if you want to share debug settings)
.vscode/launch.json

# Local settings (user-specific)
.vscode/settings.json

# Keep these tracked for team consistency:
# - .vscode/tasks.json
# - .vscode/extensions.json
# - .vscode/arduino.json

# Other IDEs
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------------------------
# Secrets & Credentials (CRITICAL)
# ---------------------------
# Secrets files - NEVER commit these!
**/secrets.h
**/secrets.cpp
!**/secrets.example.h

# Generic credential files
**/credentials.h
**/credentials.cpp
**/passwords.h
**/passwords.cpp
**/config.local.h

# Environment files
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Firebase / Google Cloud
**/service-account*.json
**/firebase-adminsdk*.json
**/google-credentials*.json
firebase-debug.log
.firebase/
.firebaserc

# Private keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# ---------------------------
# Build Outputs
# ---------------------------
*.bin
*.hex
*.elf
*.map
*.o
*.obj
build/
firmware/
output/

# ---------------------------
# Backup & Temporary Files
# ---------------------------
*.bak
*.backup
*.tmp
*.temp
*~
*.swp
*.swo
*.orig

# ---------------------------
# Logs
# ---------------------------
*.log
logs/

# ---------------------------
# OS Generated Files
# ---------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
*.lnk
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------------------------
# References & Documentation (OPTIONAL)
# ---------------------------
# Uncomment if you don't want to track these:
# references/
# docs/private/

# ---------------------------
# Optional: Development Folders
# ---------------------------
# Uncomment to exclude from tracking:
# slaveCode/
# test_code/
# experimental/
# sandbox/

# ---------------------------
# Node.js (if using dashboards/tools)
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---------------------------
# Python (if using scripts)
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------
# Database Dumps (may contain sensitive data)
# ---------------------------
# Be careful - these may contain real user data
*-rtdb-export*.json
*-export.json
backup*.json
*dump*.sql
*.sqlite
*.db